
<div style="max-width: 420px; margin: 70px auto; padding: 30px; border: 1px solid #ddd; border-radius: 15px; font-family: sans-serif;">

  <h1 style="text-align: center;">漢越音チャレンジ</h1>
  <h2 style="text-align: center;">ログイン</h2>

  <%= form_with model: resource,
                url: session_path(resource_name),
                local: true,
                data: { turbo: false } do |f| %>

    <div style="margin: 20px 0;">
      <%= f.label :name, "ユーザー名" %>
      <%= f.text_field :name,
          autofocus: true,
          required: true,
          autocomplete: "username",
          style: "display: block; width: 100%; box-sizing: border-box; padding: 12px;" %>
    </div>

    <div style="margin: 20px 0;">
      <%= f.label :password, "パスワード" %>
      <%= f.password_field :password,
          required: true,
          autocomplete: "current-password",
          style: "display: block; width: 100%; box-sizing: border-box; padding: 12px;" %>
    </div>

    <%= f.submit "ログイン",
        style: "width: 100%; padding: 14px; background: #2563eb; color: white; border: none; border-radius: 8px; cursor: pointer;" %>

  <% end %>

  <p style="text-align: center; margin-top: 20px;">
    アカウントがない方は
    <%= link_to "新規登録", new_player_registration_path %>
  </p>

</div>
