
<div style="max-width: 420px; margin: 70px auto; padding: 30px; border: 1px solid #ddd; border-radius: 15px; font-family: sans-serif;">

  <h1 style="text-align: center;">漢越音チャレンジ</h1>
  <h2 style="text-align: center;">新規登録</h2>

  <%= form_with model: resource,
                url: registration_path(resource_name),
                local: true,
                data: { turbo: false } do |f| %>

    <%= render "devise/shared/error_messages", resource: resource %>

    <div style="margin: 20px 0;">
      <%= f.label :name, "ユーザー名" %>
      <%= f.text_field :name, required: true, autofocus: true,
          style: "display: block; width: 100%; box-sizing: border-box; padding: 12px;" %>
    </div>

    <div style="margin: 20px 0;">
      <%= f.label :password, "パスワード（6文字以上）" %>
      <%= f.password_field :password, required: true, minlength: 6,
          style: "display: block; width: 100%; box-sizing: border-box; padding: 12px;" %>
    </div>

    <div style="margin: 20px 0;">
      <%= f.label :password_confirmation, "パスワード確認" %>
      <%= f.password_field :password_confirmation, required: true,
          style: "display: block; width: 100%; box-sizing: border-box; padding: 12px;" %>
    </div>

    <%= f.submit "新規登録",
        style: "width: 100%; padding: 14px; background: #2563eb; color: white; border: none; border-radius: 8px; cursor: pointer;" %>

  <% end %>

  <p style="text-align: center; margin-top: 20px;">
    <%= link_to "ログインはこちら", new_player_session_path %>
  </p>
</div>
